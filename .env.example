# Copy to .env locally. Never put this key in frontend/VITE_ variables.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ORDERS_DB_PATH=data/runtime/orders.sqlite3
# Default: cache misses never trigger paid embedding calls.
RAG_ALLOW_API=false
# Enable explicitly for interactive consultation; restart the backend after changing.
AGENT_ALLOW_API=false
